{
  "name": "chirp-hub",
  "version": "0.1.0",
  "description": "Desktop app that sets up cameras, LoRaWAN and Zigbee/Thread on a Chirp IoT Hub without a terminal",
  "private": true,
  "type": "module",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "check:boundaries:self-test": "tsx scripts/check-boundaries.ts --self-test",
    "check": "npm run lint && npm run check:boundaries:self-test && npm run check:boundaries && npm run typecheck && npm run build && npm run test:smoke",
    "test:smoke": "electron tests/smoke.mjs",
    "lint": "oxlint",
    "format": "prettier --write \"src/**/*.{ts,tsx,json}\" \"scripts/**/*.ts\" \"tests/**/*.mjs\" \"*.ts\"",
    "package": "electron-vite build && electron-builder",
    "package:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@chirpwireless/ui-kit": "git+https://github.com/chirpwireless/ui-kit.git#542ddde4e0d7ceecada5ae3de32b4611dd22f2c0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "date-fns": "^2.30.0",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "i18next": "^24.2.2",
    "mqtt": "^5.15.2",
    "mui-tel-input": "^11.0.0",
    "react": "^19.2.8",
    "react-colorful": "^5.8.0",
    "react-date-range": "^1.4.0",
    "react-dom": "^19.2.8",
    "react-dropzone": "^14.4.1",
    "react-hook-form": "^7.83.0",
    "react-i18next": "^15.4.0",
    "react-imask": "^7.6.1",
    "react-router-dom": "6.30.4",
    "react-toastify": "^10.0.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.6",
    "typescript": "7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "comments": {
    "react-router-dom": "PINNED to 6.30.4, NOT 7.x. The ui-kit peer range is ^6.26.1 and RouterLink/Link/GeneralInfoCard import from it directly. A deliberate exception to 'use the latest version' \u2014 see app/electron.md.",
    "typescript": "7.0.2, the current stable release. The fallback to 5.x described in electron.md was NOT needed: TS 7 typechecks MUI v9, React 19, generics, sx callbacks and the ui-kit subpath imports with zero errors \u2014 including the 37 ui-kit dist .d.ts files that reference node_modules paths, which skipLibCheck covers. Verified 2026-08-01 before pinning.",
    "@chirpwireless/ui-kit": "Pinned to a commit SHA rather than a branch so builds are reproducible. 542ddde is v1.0.0 with MUI v9 peers and a committed dist/, the same tree chirp-frontend consumes.",
    "oxlint": "oxlint instead of ESLint: typescript-eslint peers >=4.8.4 <6.1.0, so it supports neither TypeScript 7 (current stable, used here) nor TypeScript 6 (still beta), and cannot parse these files at all. oxlint is Rust-based with its own parser, never invokes tsc, and reads ESLint v8-style config. eslint.config.js.pending is kept for when typescript-eslint catches up."
  },
  "allowScripts": {
    "core-js-pure@3.49.0": true,
    "electron@43.2.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true
  },
  "build": {
    "appId": "io.chirpwireless.hub",
    "productName": "Chirp Hub",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "AppImage",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "desktop": {
        "entry": {
          "Name": "Chirp Hub",
          "Comment": "Set up cameras, LoRaWAN and Zigbee on this device"
        }
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.utilities"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "chirpdepin",
        "repo": "raspberry-pi-iot-hub"
      }
    ],
    "extraResources": [
      {
        "from": "../config/zigbee-configuration.yaml.template",
        "to": "zigbee-configuration.yaml.template"
      }
    ]
  }
}
